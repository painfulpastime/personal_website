---
import Base from '../layouts/Base.astro';
import { profile, completed } from '../data/profile';
---
<Base title="CV"><div class="wrap inner-page"><header class="page-intro"><p class="eyebrow">EXPERIENCE / EDUCATION / CONTINUING CURIOSITY</p><h1>Simon Mwaura<span class="red-dot">.</span></h1><p class="lead">Engineer | Systems Modelling & Optimisation</p><div class="cv-top"><span>Mauritius</span><a href={`mailto:${profile.email}`}>Email me ↗</a><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></header><section class="cv-section"><h2>Profile</h2><p>Electrical engineering background, with a focus on modelling systems and quantifying uncertainty in real-estate analytics. Interests in optimisation, statistical learning, dynamic systems, state estimation, and control.</p></section><section class="cv-section"><h2>Experience</h2><div><article class="cv-item"><h3>Research and Analytics Engineer</h3><p>Werttax International Ltd</p><p class="cv-date">July 2025–Present</p><p>Support the adaptation of established German valuation methodologies and analytical tooling to the Mauritian real-estate market.</p></article><article class="cv-item"><h3>Solo-preneur</h3><p>Self-employed</p><p class="cv-date">November 2019–Present</p><p>Market research and analytical skills.</p></article></div></section><section class="cv-section"><h2>Education</h2><div><article class="cv-item"><h3>MEng Electrical Power Engineering</h3><p>Glasgow Caledonian University · Pamplemousses, Mauritius</p><p class="cv-date">January 2021–May 2025</p><p>Relevant modules: Mathematics, Energy Audit and Management, Modeling and Data Analysis, Operations Management.</p></article><article class="cv-item"><h3>Leadership Core</h3><p>African Leadership University · Pamplemousses, Mauritius</p><p class="cv-date">January–August 2021</p><p>Project management, Entrepreneurial Leadership, Critical thinking, and Communication for impact.</p></article></div></section><section class="cv-section"><h2>Coursework</h2><div>{completed.map(([title,issuer,date]) => <article class="cv-item"><h3>{title}</h3><p class="cv-date">{issuer} · {date}</p></article>)}</div></section></div></Base>
