---
import Base from '../layouts/Base.astro';
import { learning, completed } from '../data/profile';
---
<Base title="Learning" active="learning"><div class="wrap inner-page"><header class="page-intro"><p class="eyebrow">ONGOING QUESTIONS / ONGOING LEARNING</p><h1>Always<br />a student<span class="red-dot">.</span></h1><p class="lead">Following my curiosity into algorithms, financial engineering, and deep learning. Here’s what I’m working through, alongside some of the coursework behind it.</p></header><section aria-label="Study in progress">{learning.map(item => <article id={`area-${item.number}`} class="learning-detail"><span class="index-number">{item.number}</span><div><h2>{item.title}</h2><p>{item.focus}</p><ul>{item.courses.map(course => <li>{course}</li>)}</ul><p class="micro">{item.detail}</p></div><span class="status"><span aria-hidden="true">↗</span> In progress</span></article>)}</section><section class="course-list"><p class="eyebrow">FOUNDATIONS & FOLLOW-THROUGHS</p><h2>Completed coursework<span class="red-dot">.</span></h2>{completed.map(([title, issuer, date]) => <article class="course-row"><h3>{title}</h3><span>{issuer}</span><span>{date}</span></article>)}<p class="micro" style="margin-top: 25px">LEARNING STATUS LAST REVIEWED: OCTOBER 2026</p></section></div></Base>
